# ==========================================
# JARVIS-NG Configuration
# ==========================================

# Allgemein
JARVIS_DEBUG=true

# KI-Provider
JARVIS_AI_PROVIDER=gemini

# Gemini
JARVIS_GEMINI_API_KEY=your_gemini_api_key_here
JARVIS_GEMINI_MODEL=gemini-flash-latest

# Ollama
JARVIS_OLLAMA_HOST=http://localhost:11434

# OpenAI
JARVIS_OPENAI_API_KEY=